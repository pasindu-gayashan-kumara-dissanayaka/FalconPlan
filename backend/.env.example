# Copy to .env locally ONLY if needed; this backend does not auto-load .env.
PORT=3000
NODE_ENV=development
# Never commit credential values or keys. Use deployment environment variables.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: GOOGLE_APPLICATION_CREDENTIALS points to private JSON path outside Git.
# Option B: FIREBASE_SERVICE_ACCOUNT_JSON contains complete secret JSON in protected host env.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/outside-git/firebase-admin.json
# FIREBASE_SERVICE_ACCOUNT_JSON=<protected server secret only>
