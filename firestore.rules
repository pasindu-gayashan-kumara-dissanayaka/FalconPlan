rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidActiveMode(mode) {
      return mode is string && (mode == 'traveler' || mode == 'provider');
    }

    function hasOnlyAllowedProfileKeys(data) {
      return data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'activeMode', 'createdAt', 'updatedAt']);
    }

    function isValidProfileData(data) {
      return hasOnlyAllowedProfileKeys(data)
        && (data.uid is string)
        && (data.displayName is string)
        && (data.email is string)
        && (data.photoUrl is string)
        && isValidActiveMode(data.activeMode)
        && (data.createdAt is number || data.createdAt is timestamp)
        && (data.updatedAt is number || data.updatedAt is timestamp);
    }

    // User Profiles: users/{userId}
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && isValidProfileData(request.resource.data);

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidProfileData(request.resource.data);

      allow delete: if false;

      // Saved Places Subcollection: users/{userId}/savedPlaces/{savedPlaceId}
      match /savedPlaces/{savedPlaceId} {
        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['id', 'destinationId', 'destinationName', 'district', 'latitude', 'longitude', 'note', 'createdAt', 'updatedAt'])
          && request.resource.data.id is string
          && request.resource.data.destinationId is string
          && request.resource.data.destinationName is string
          && request.resource.data.district is string
          && request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0
          && request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0
          && request.resource.data.note is string;

        allow delete: if isOwner(userId);
      }

      // Travel Plans Subcollection: users/{userId}/travelPlans/{planId}
      match /travelPlans/{planId} {
        allow read, delete: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['id', 'ownerUid', 'title', 'description', 'startDate', 'endDate', 'status', 'createdAt', 'updatedAt', 'stopCount'])
          && request.resource.data.id is string
          && request.resource.data.ownerUid == userId
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && request.resource.data.description is string && request.resource.data.description.size() <= 500
          && (request.resource.data.status == 'draft' || request.resource.data.status == 'planned')
          && request.resource.data.startDate is number
          && request.resource.data.endDate is number;

        // Travel Plan Stops Subcollection: users/{userId}/travelPlans/{planId}/stops/{stopId}
        match /stops/{stopId} {
          allow read, delete: if isOwner(userId);

          allow create, update: if isOwner(userId)
            && request.resource.data.keys().hasOnly(['id', 'destinationId', 'destinationName', 'district', 'latitude', 'longitude', 'visitDate', 'notes', 'orderIndex'])
            && request.resource.data.id is string
            && request.resource.data.destinationId is string
            && request.resource.data.destinationName is string
            && request.resource.data.district is string
            && request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0
            && request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0
            && request.resource.data.notes is string
            && request.resource.data.orderIndex is number;
        }
      }
    }

    // Deny read and write access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
