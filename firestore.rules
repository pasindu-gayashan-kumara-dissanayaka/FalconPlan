rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidActiveMode(mode) {
      return mode is string && (mode == 'traveler' || mode == 'provider');
    }

    function hasOnlyAllowedProfileKeys(data) {
      return data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'activeMode', 'createdAt', 'updatedAt']);
    }

    function isValidProfileData(data) {
      return hasOnlyAllowedProfileKeys(data)
        && (data.uid is string)
        && (data.displayName is string)
        && (data.email is string)
        && (data.photoUrl is string)
        && isValidActiveMode(data.activeMode)
        && (data.createdAt is number || data.createdAt is timestamp)
        && (data.updatedAt is number || data.updatedAt is timestamp);
    }

    function isValidTravelPlan(data, userId, planId) {
      return data.keys().hasOnly(['id', 'ownerUid', 'title', 'description', 'startDate', 'endDate', 'status', 'createdAt', 'updatedAt', 'stopCount'])
        && data.id == planId
        && data.ownerUid == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 500
        && (data.status == 'draft' || data.status == 'planned' || data.status == 'published')
        && data.startDate is number
        && data.endDate is number
        && data.startDate <= data.endDate
        && data.stopCount is number && data.stopCount >= 0;
    }

    function isValidPlanStop(data, stopId) {
      return data.keys().hasOnly(['id', 'destinationId', 'destinationName', 'district', 'latitude', 'longitude', 'visitDate', 'notes', 'orderIndex'])
        && data.id == stopId
        && data.destinationId is string
        && data.destinationName is string
        && data.district is string
        && data.latitude >= -90.0 && data.latitude <= 90.0
        && data.longitude >= -180.0 && data.longitude <= 180.0
        && data.visitDate is number
        && data.notes is string
        && data.orderIndex is number && data.orderIndex >= 0;
    }

    // User Profiles: users/{userId}
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && isValidProfileData(request.resource.data);

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidProfileData(request.resource.data);

      allow delete: if false;

      // Saved Places Subcollection: users/{userId}/savedPlaces/{savedPlaceId}
      match /savedPlaces/{savedPlaceId} {
        allow read, delete: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['id', 'destinationId', 'destinationName', 'district', 'latitude', 'longitude', 'note', 'createdAt', 'updatedAt'])
          && request.resource.data.id == savedPlaceId
          && request.resource.data.destinationId is string
          && request.resource.data.destinationName is string
          && request.resource.data.district is string
          && request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0
          && request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0
          && request.resource.data.note is string;
      }

      // Travel Plans Subcollection: users/{userId}/travelPlans/{planId}
      match /travelPlans/{planId} {
        allow read, delete: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidTravelPlan(request.resource.data, userId, planId);

        allow update: if isOwner(userId)
          && isValidTravelPlan(request.resource.data, userId, planId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt;

        // Travel Plan Stops Subcollection: users/{userId}/travelPlans/{planId}/stops/{stopId}
        match /stops/{stopId} {
          allow read, delete: if isOwner(userId);

          allow create: if isOwner(userId)
            && isValidPlanStop(request.resource.data, stopId);

          allow update: if isOwner(userId)
            && isValidPlanStop(request.resource.data, stopId)
            && request.resource.data.id == resource.data.id
            && request.resource.data.destinationId == resource.data.destinationId;
        }
      }
    }

    // Provider Profiles: providerProfiles/{userId}
    match /providerProfiles/{userId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'hostDisplayName', 'businessName', 'businessType', 'district', 'village', 'shortDescription', 'contactPhone', 'kycStatus', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.hostDisplayName is string && request.resource.data.hostDisplayName.size() > 0 && request.resource.data.hostDisplayName.size() <= 100
        && request.resource.data.businessName is string && request.resource.data.businessName.size() > 0 && request.resource.data.businessName.size() <= 100
        && (request.resource.data.businessType == 'homestay' || request.resource.data.businessType == 'experience' || request.resource.data.businessType == 'both')
        && request.resource.data.district is string && request.resource.data.district.size() > 0
        && request.resource.data.village is string && request.resource.data.village.size() > 0
        && request.resource.data.shortDescription is string && request.resource.data.shortDescription.size() <= 500
        && request.resource.data.contactPhone is string
        && (request.resource.data.kycStatus == 'pending_identity_verification' || request.resource.data.kycStatus == 'verified');

      allow delete: if false;
    }

    // Public Travel Plans Collection: publicTravelPlans/{planId}
    match /publicTravelPlans/{planId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via trusted Admin SDK / backend
    }

    // Deny read and write access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}