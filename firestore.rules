rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidActiveMode(mode) {
      return mode is string && (mode == 'traveler' || mode == 'provider');
    }

    function hasOnlyAllowedProfileKeys(data) {
      return data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'activeMode', 'createdAt', 'updatedAt']);
    }

    function isValidProfileData(data) {
      return hasOnlyAllowedProfileKeys(data)
        && (data.uid is string)
        && (data.displayName is string)
        && (data.email is string)
        && (data.photoUrl is string)
        && isValidActiveMode(data.activeMode)
        && (data.createdAt is number || data.createdAt is timestamp)
        && (data.updatedAt is number || data.updatedAt is timestamp);
    }

    function isValidTravelPlan(data, userId, planId) {
      return data.keys().hasOnly(['id', 'ownerUid', 'title', 'description', 'startDate', 'endDate', 'status', 'createdAt', 'updatedAt', 'stopCount'])
        && data.id == planId
        && data.ownerUid == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 500
        && (data.status == 'draft' || data.status == 'planned' || data.status == 'published')
        && data.startDate is number
        && data.endDate is number
        && data.startDate <= data.endDate
        && data.stopCount is number && data.stopCount >= 0;
    }

    function isValidPlanStop(data, stopId) {
      return data.keys().hasOnly(['id', 'destinationId', 'destinationName', 'district', 'latitude', 'longitude', 'visitDate', 'notes', 'orderIndex'])
        && data.id == stopId
        && data.destinationId is string
        && data.destinationName is string
        && data.district is string
        && data.latitude >= -90.0 && data.latitude <= 90.0
        && data.longitude >= -180.0 && data.longitude <= 180.0
        && data.visitDate is number
        && data.notes is string
        && data.orderIndex is number && data.orderIndex >= 0;
    }

    // User Profiles: users/{userId}
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && isValidProfileData(request.resource.data);

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidProfileData(request.resource.data);

      allow delete: if false;

      // Saved Places Subcollection: users/{userId}/savedPlaces/{savedPlaceId}
      match /savedPlaces/{savedPlaceId} {
        allow read, delete: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['id', 'destinationId', 'destinationName', 'district', 'latitude', 'longitude', 'note', 'createdAt', 'updatedAt'])
          && request.resource.data.id == savedPlaceId
          && request.resource.data.destinationId is string
          && request.resource.data.destinationName is string
          && request.resource.data.district is string
          && request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0
          && request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0
          && request.resource.data.note is string;
      }

      // Travel Plans Subcollection: users/{userId}/travelPlans/{planId}
      match /travelPlans/{planId} {
        allow read, delete: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidTravelPlan(request.resource.data, userId, planId);

        allow update: if isOwner(userId)
          && isValidTravelPlan(request.resource.data, userId, planId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt;

        // Travel Plan Stops Subcollection: users/{userId}/travelPlans/{planId}/stops/{stopId}
        match /stops/{stopId} {
          allow read, delete: if isOwner(userId);

          allow create: if isOwner(userId)
            && isValidPlanStop(request.resource.data, stopId);

          allow update: if isOwner(userId)
            && isValidPlanStop(request.resource.data, stopId)
            && request.resource.data.id == resource.data.id
            && request.resource.data.destinationId == resource.data.destinationId;
        }
      }
    }

    // Provider Profiles: providerProfiles/{userId}
    match /providerProfiles/{userId} {
      allow read: if isOwner(userId);

      // Create: Owner only, kycStatus MUST BE strictly 'pending_identity_verification'
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'hostDisplayName', 'businessName', 'businessType', 'district', 'village', 'shortDescription', 'contactPhone', 'kycStatus', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.hostDisplayName is string && request.resource.data.hostDisplayName.size() > 0 && request.resource.data.hostDisplayName.size() <= 100
        && request.resource.data.businessName is string && request.resource.data.businessName.size() > 0 && request.resource.data.businessName.size() <= 100
        && (request.resource.data.businessType == 'homestay' || request.resource.data.businessType == 'experience' || request.resource.data.businessType == 'both')
        && request.resource.data.district is string && request.resource.data.district.size() > 0
        && request.resource.data.village is string && request.resource.data.village.size() > 0
        && request.resource.data.shortDescription is string && request.resource.data.shortDescription.size() <= 500
        && request.resource.data.contactPhone is string
        && request.resource.data.kycStatus == 'pending_identity_verification';

      // Update: Owner only, kycStatus MUST BE IMMUTABLE (cannot be modified or escalated client-side)
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'hostDisplayName', 'businessName', 'businessType', 'district', 'village', 'shortDescription', 'contactPhone', 'kycStatus', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.kycStatus == resource.data.kycStatus
        && request.resource.data.hostDisplayName is string && request.resource.data.hostDisplayName.size() > 0 && request.resource.data.hostDisplayName.size() <= 100
        && request.resource.data.businessName is string && request.resource.data.businessName.size() > 0 && request.resource.data.businessName.size() <= 100
        && (request.resource.data.businessType == 'homestay' || request.resource.data.businessType == 'experience' || request.resource.data.businessType == 'both')
        && request.resource.data.district is string && request.resource.data.district.size() > 0
        && request.resource.data.village is string && request.resource.data.village.size() > 0
        && request.resource.data.shortDescription is string && request.resource.data.shortDescription.size() <= 500
        && request.resource.data.contactPhone is string;

      allow delete: if false;

      // Provider Listings Subcollection: providerProfiles/{userId}/listings/{listingId}
      match /listings/{listingId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['id', 'providerUid', 'listingType', 'title', 'description', 'district', 'village', 'status', 'createdAt', 'updatedAt', 'maxGuests', 'bedrooms', 'amenities', 'durationMinutes', 'maxParticipants', 'experienceCategory'])
          && request.resource.data.id == listingId
          && request.resource.data.providerUid == userId
          && (request.resource.data.listingType == 'homestay' || request.resource.data.listingType == 'experience')
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && request.resource.data.description is string && request.resource.data.description.size() <= 500
          && request.resource.data.district is string && request.resource.data.district.size() > 0
          && request.resource.data.village is string && request.resource.data.village.size() > 0
          && request.resource.data.status == 'draft'
          && request.resource.data.maxGuests is number && request.resource.data.maxGuests >= 0
          && request.resource.data.bedrooms is number && request.resource.data.bedrooms >= 0
          && request.resource.data.durationMinutes is number && request.resource.data.durationMinutes >= 0
          && request.resource.data.maxParticipants is number && request.resource.data.maxParticipants >= 0;

        allow update: if isOwner(userId)
          && resource.data.status == 'draft'
          && request.resource.data.status == 'draft'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'providerUid', 'createdAt', 'status'])
          && request.resource.data.keys().hasOnly(['id', 'providerUid', 'listingType', 'title', 'description', 'district', 'village', 'status', 'createdAt', 'updatedAt', 'maxGuests', 'bedrooms', 'amenities', 'durationMinutes', 'maxParticipants', 'experienceCategory'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.providerUid == resource.data.providerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && (request.resource.data.listingType == 'homestay' || request.resource.data.listingType == 'experience')
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && request.resource.data.description is string && request.resource.data.description.size() <= 500
          && request.resource.data.district is string && request.resource.data.district.size() > 0
          && request.resource.data.village is string && request.resource.data.village.size() > 0
          && request.resource.data.maxGuests is number && request.resource.data.maxGuests >= 0
          && request.resource.data.bedrooms is number && request.resource.data.bedrooms >= 0
          && request.resource.data.durationMinutes is number && request.resource.data.durationMinutes >= 0
          && request.resource.data.maxParticipants is number && request.resource.data.maxParticipants >= 0;

        allow delete: if isOwner(userId)
          && resource.data.status == 'draft';

        // Listing Photos Subcollection: providerProfiles/{userId}/listings/{listingId}/photos/{photoId}
        match /photos/{photoId} {
          allow read: if isOwner(userId);
          allow write: if false; // Server-managed via trusted Express Backend / Admin SDK
        }

        // Provider Rooms Subcollection: providerProfiles/{userId}/listings/{listingId}/rooms/{roomId}
        match /rooms/{roomId} {
          allow read: if isOwner(userId);

          allow create: if isOwner(userId)
            && get(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)).data.status == 'draft'
            && get(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)).data.listingType == 'homestay'
            && request.resource.data.keys().hasOnly(['id', 'providerUid', 'listingId', 'roomName', 'roomType', 'description', 'totalUnits', 'maxGuestsPerUnit', 'bedCount', 'bedType', 'bathroomType', 'amenities', 'createdAt', 'updatedAt'])
            && request.resource.data.id == roomId
            && request.resource.data.providerUid == userId
            && request.resource.data.listingId == listingId
            && (request.resource.data.roomType == 'single' || request.resource.data.roomType == 'double' || request.resource.data.roomType == 'twin' || request.resource.data.roomType == 'family' || request.resource.data.roomType == 'dormitory' || request.resource.data.roomType == 'other')
            && request.resource.data.roomName is string && request.resource.data.roomName.size() > 0 && request.resource.data.roomName.size() <= 100
            && request.resource.data.description is string && request.resource.data.description.size() <= 500
            && request.resource.data.totalUnits is number && request.resource.data.totalUnits > 0
            && request.resource.data.maxGuestsPerUnit is number && request.resource.data.maxGuestsPerUnit > 0
            && request.resource.data.bedCount is number && request.resource.data.bedCount >= 0
            && (request.resource.data.bathroomType == 'private' || request.resource.data.bathroomType == 'shared');

          allow update: if isOwner(userId)
            && resource.data.providerUid == userId
            && get(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)).data.status == 'draft'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'providerUid', 'listingId', 'createdAt'])
            && request.resource.data.id == resource.data.id
            && request.resource.data.providerUid == resource.data.providerUid
            && request.resource.data.listingId == resource.data.listingId
            && request.resource.data.createdAt == resource.data.createdAt
            && (request.resource.data.roomType == 'single' || request.resource.data.roomType == 'double' || request.resource.data.roomType == 'twin' || request.resource.data.roomType == 'family' || request.resource.data.roomType == 'dormitory' || request.resource.data.roomType == 'other')
            && request.resource.data.roomName is string && request.resource.data.roomName.size() > 0 && request.resource.data.roomName.size() <= 100
            && request.resource.data.description is string && request.resource.data.description.size() <= 500
            && request.resource.data.totalUnits is number && request.resource.data.totalUnits > 0
            && request.resource.data.maxGuestsPerUnit is number && request.resource.data.maxGuestsPerUnit > 0
            && request.resource.data.bedCount is number && request.resource.data.bedCount >= 0
            && (request.resource.data.bathroomType == 'private' || request.resource.data.bathroomType == 'shared');

          allow delete: if isOwner(userId)
            && get(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)).data.status == 'draft';

          // Room Pricing Subcollection: providerProfiles/{userId}/listings/{listingId}/rooms/{roomId}/pricing/{pricingId}
          match /pricing/{pricingId} {
            allow read: if isOwner(userId);

            allow create: if isOwner(userId)
              && pricingId == 'current'
              && exists(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)/rooms/$(roomId))
              && get(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)).data.status == 'draft'
              && get(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)).data.listingType == 'homestay'
              && request.resource.data.keys().hasOnly(['currency', 'pricePerNightLkr', 'includedGuests', 'extraGuestFeeLkr', 'breakfastOffered', 'breakfastFeePerGuestLkr', 'createdAt', 'updatedAt'])
              && request.resource.data.currency == 'LKR'
              && request.resource.data.pricePerNightLkr is int && request.resource.data.pricePerNightLkr > 0
              && request.resource.data.includedGuests is int && request.resource.data.includedGuests > 0
              && request.resource.data.includedGuests <= get(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)/rooms/$(roomId)).data.maxGuestsPerUnit
              && request.resource.data.extraGuestFeeLkr is int && request.resource.data.extraGuestFeeLkr >= 0
              && request.resource.data.breakfastOffered is bool
              && request.resource.data.breakfastFeePerGuestLkr is int && request.resource.data.breakfastFeePerGuestLkr >= 0
              && (request.resource.data.breakfastOffered || request.resource.data.breakfastFeePerGuestLkr == 0);

            allow update: if isOwner(userId)
              && pricingId == 'current'
              && exists(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)/rooms/$(roomId))
              && get(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)).data.status == 'draft'
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'currency'])
              && request.resource.data.keys().hasOnly(['currency', 'pricePerNightLkr', 'includedGuests', 'extraGuestFeeLkr', 'breakfastOffered', 'breakfastFeePerGuestLkr', 'createdAt', 'updatedAt'])
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.currency == 'LKR'
              && request.resource.data.pricePerNightLkr is int && request.resource.data.pricePerNightLkr > 0
              && request.resource.data.includedGuests is int && request.resource.data.includedGuests > 0
              && request.resource.data.includedGuests <= get(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)/rooms/$(roomId)).data.maxGuestsPerUnit
              && request.resource.data.extraGuestFeeLkr is int && request.resource.data.extraGuestFeeLkr >= 0
              && request.resource.data.breakfastOffered is bool
              && request.resource.data.breakfastFeePerGuestLkr is int && request.resource.data.breakfastFeePerGuestLkr >= 0
              && (request.resource.data.breakfastOffered || request.resource.data.breakfastFeePerGuestLkr == 0);

            allow delete: if isOwner(userId)
              && pricingId == 'current'
              && get(/databases/$(database)/documents/providerProfiles/$(userId)/listings/$(listingId)).data.status == 'draft';
          }

          // Room Availability Subcollection: providerProfiles/{userId}/listings/{listingId}/rooms/{roomId}/availabilityDays/{date}
          match /availabilityDays/{date} {
            allow read: if isOwner(userId);
            allow write: if false; // Server-managed via trusted Express Backend / Admin SDK
          }
        }
      }
    }

    // KYC Document Records: kyc/{userId}
    match /kyc/{userId} {
      allow read, write: if false; // Deny direct client read and write; managed strictly via trusted Express Backend / Admin SDK
    }

    // KYC Audit Logs: kycAuditLogs/{logId}
    match /kycAuditLogs/{logId} {
      allow read, write: if false; // Deny direct client read and write; append-only via trusted Express Backend / Admin SDK
    }

    // Public Travel Plans Collection: publicTravelPlans/{planId}
    match /publicTravelPlans/{planId} {
      allow read, write: if false; // Deny direct client read and write; all public plan browsing uses trusted backend
    }

    // Public Listings Collection: publicListings/{listingId}
    match /publicListings/{listingId} {
      allow read, write: if false; // Deny direct client read and write; all public listing browsing uses trusted backend
    }

    // Listing Audit Logs: listingAuditLogs/{logId}
    match /listingAuditLogs/{logId} {
      allow read, write: if false; // Append-only via server Admin SDK
    }

    // Deny read and write access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}