rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidActiveMode(mode) {
      return mode is string && (mode == 'traveler' || mode == 'provider');
    }

    function hasOnlyAllowedProfileKeys(data) {
      return data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'activeMode', 'createdAt', 'updatedAt']);
    }

    function isValidProfileData(data) {
      return hasOnlyAllowedProfileKeys(data)
        && (data.uid is string)
        && (data.displayName is string)
        && (data.email is string)
        && (data.photoUrl is string)
        && isValidActiveMode(data.activeMode)
        && (data.createdAt is number || data.createdAt is timestamp)
        && (data.updatedAt is number || data.updatedAt is timestamp);
    }

    // User Profiles: users/{userId}
    match /users/{userId} {
      // Authenticated users can only read their own profile
      allow read: if isOwner(userId);

      // Create: Owner only, strictly allowed keys, valid types, matching UID
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && isValidProfileData(request.resource.data);

      // Update: Owner only, strictly allowed keys, valid types, immutable UID & createdAt
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidProfileData(request.resource.data);

      // Client-side delete prohibited
      allow delete: if false;
    }

    // Deny read and write access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}