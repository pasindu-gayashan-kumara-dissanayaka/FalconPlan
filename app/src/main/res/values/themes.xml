<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FalconPlan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorOnSecondary">@color/on_accent_orange</item>
        <item name="colorSecondaryContainer">@color/accent_orange_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_orange_container</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Rounded Shape Styles -->
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.FalconPlan.ExtraLarge</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.FalconPlan.Large</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.FalconPlan.Medium</item>

        <!-- System UI Window Flags -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.FalconPlan" parent="Base.Theme.FalconPlan" />

    <!-- Custom Shapes -->
    <style name="ShapeAppearance.FalconPlan.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ShapeAppearance.FalconPlan.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.FalconPlan.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Bottom Sheet Dialog Theme -->
    <style name="Theme.FalconPlan.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.FalconPlan.BottomSheet</item>
    </style>

    <style name="Widget.FalconPlan.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FalconPlan.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.FalconPlan.BottomSheet" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>